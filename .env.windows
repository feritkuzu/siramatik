# Sıramatik Sistemi - Windows Development Environment Variables
# Bu dosyayı C:\wamp64\www\siramatik\.env olarak kaydedin

# Development Mode
NODE_ENV=development

# Port Konfigürasyonu
PORT=3000

# OAuth Configuration
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# JWT Secret (Oturum yönetimi için)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Owner Information
OWNER_OPEN_ID=your-owner-open-id
OWNER_NAME=Admin

# App Configuration
VITE_APP_TITLE=Sıramatik Sistemi
VITE_APP_LOGO=

# Yazıcı Ayarları (Windows Native Printer)
# PRINTER_NAME=Zjiang ZJ-5890K
# PRINTER_PORT=9100

# Veritabanı (Development'ta SQLite otomatik kullanılır)
# DATABASE_URL=sqlite:./db.sqlite
