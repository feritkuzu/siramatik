# Sıramatik Sistemi - Windows Development Environment Variables
# Bu dosyayı C:\wamp64\www\siramatik\.env olarak kaydedin

# Development Mode
NODE_ENV=development

# Port Konfigürasyonu
PORT=3000

# Manus OAuth Configuration (Sandbox'tan alınan değerler)
VITE_APP_ID=6WnCokWgb4rfLgjGA27M8D
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im

# JWT Secret (Oturum yönetimi için)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Manus Built-in APIs (Sandbox'ta otomatik sağlanır)
BUILT_IN_FORGE_API_URL=https://api.manus.im
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# Owner Information (Sandbox'ta otomatik sağlanır)
OWNER_OPEN_ID=your-owner-open-id
OWNER_NAME=Admin

# Analytics (Opsiyonel - Boş bırakılabilir)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Frontend Configuration
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im
VITE_FRONTEND_FORGE_API_KEY=your-frontend-forge-api-key

# App Configuration
VITE_APP_TITLE=Sıramatik Sistemi
VITE_APP_LOGO=

# Yazıcı Ayarları (Windows Native Printer)
# PRINTER_NAME=Zjiang ZJ-5890K
# PRINTER_PORT=9100

# Veritabanı (Development'ta SQLite otomatik kullanılır)
# DATABASE_URL=sqlite:./db.sqlite
